{
    "$schema": "./schemas/ottabase-manifest.schema.json",
    "description": "Ottabase package manifest. Defines package tiers for open-source vs PRO distribution.",
    "tiers": {
        "community": "Included in the open-source distribution. Free for all users.",
        "pro": "Available only in the PRO distribution. Requires a license."
    },
    "packages": {
        "@ottabase/analytics": { "tier": "community", "description": "Cloudflare Analytics Engine (WAE)" },
        "@ottabase/api": { "tier": "community", "description": "API utilities and helpers" },
        "@ottabase/audit": { "tier": "pro", "description": "Audit logging middleware & event tracking" },
        "@ottabase/auth": { "tier": "community", "description": "Auth.js v5 with D1 adapter" },
        "@ottabase/brand-engine": { "tier": "pro", "description": "Dynamic brand theming engine" },
        "@ottabase/brand-engine-react": { "tier": "pro", "description": "React bindings for brand engine" },
        "@ottabase/cf": { "tier": "community", "description": "Cloudflare bindings (D1, KV, R2, Queues)" },
        "@ottabase/cf-realtime": { "tier": "pro", "description": "WebSocket pub/sub via Durable Objects" },
        "@ottabase/config": { "tier": "community", "description": "Shared configuration utilities" },
        "@ottabase/cron": { "tier": "community", "description": "Cron job handling" },
        "@ottabase/db": { "tier": "community", "description": "Drizzle D1 database driver" },
        "@ottabase/docs": { "tier": "community", "description": "Documentation site" },
        "@ottabase/email": { "tier": "community", "description": "Email service (Resend, SMTP)" },
        "@ottabase/forms": { "tier": "community", "description": "Form utilities and validation" },
        "@ottabase/hello-world": { "tier": "community", "description": "Template package for reference" },
        "@ottabase/i18n": { "tier": "community", "description": "Internationalization" },
        "@ottabase/logger": { "tier": "community", "description": "Structured logging with context" },
        "@ottabase/notifications": { "tier": "pro", "description": "Notification system with preferences" },
        "@ottabase/ottablog": { "tier": "pro", "description": "Blog functionality with EditorJS" },
        "@ottabase/ottaeditor": { "tier": "pro", "description": "EditorJS wrapper with plugins" },
        "@ottabase/ottalayout": { "tier": "community", "description": "Layout components" },
        "@ottabase/ottamenu": { "tier": "pro", "description": "Menu system with slots and brand-engine integration" },
        "@ottabase/ottaorm": { "tier": "community", "description": "Fat models, CRUD, auto-migrations, RLS" },
        "@ottabase/ottarenderer": { "tier": "pro", "description": "EditorJS block renderer" },
        "@ottabase/ottaselect": { "tier": "community", "description": "Select component" },
        "@ottabase/ottaupload": { "tier": "community", "description": "File upload (R2, CF Images)" },
        "@ottabase/queue": { "tier": "community", "description": "Job queue with deduplication & chaining" },
        "@ottabase/rbac": { "tier": "pro", "description": "Role-based access control with KV caching" },
        "@ottabase/referrals": { "tier": "pro", "description": "Referral tracking system" },
        "@ottabase/scripts": { "tier": "community", "description": "CLI tools and build scripts" },
        "@ottabase/shortlinks": { "tier": "pro", "description": "URL shortener with interstitial + WAE tracking" },
        "@ottabase/spotlight": { "tier": "community", "description": "Spotlight search component" },
        "@ottabase/state": { "tier": "community", "description": "Global state management (Jotai)" },
        "@ottabase/ui-base": { "tier": "community", "description": "Framework-agnostic base styles" },
        "@ottabase/ui-code-highlight": { "tier": "community", "description": "Code highlighting component" },
        "@ottabase/ui-components": { "tier": "community", "description": "Shared UI components" },
        "@ottabase/ui-cropper": { "tier": "community", "description": "Image cropper component" },
        "@ottabase/ui-mantine": { "tier": "community", "description": "Mantine provider and themes" },
        "@ottabase/ui-shadcn": { "tier": "community", "description": "shadcn/ui components" },
        "@ottabase/ui-split-pane": { "tier": "community", "description": "Split pane layout component" },
        "@ottabase/ui-tailwind": { "tier": "community", "description": "Tailwind CSS utilities" },
        "@ottabase/utils": { "tier": "community", "description": "Timezone, string, file utilities" }
    }
}
