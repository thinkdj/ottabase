            "id": "T1acrJa6Xq",
            "type": "faq",
            "data": {
                "style": "accordion",
                "items": [
                    {
                        "question": "What is OttaEditor?",
                        "answer": "A block editor built on Editor.js, with plugin management, undo/redo, and one-call export already wired up."
                    },
                    {
                        "question": "Which export formats are supported?",
                        "answer": "JSON and Markdown, out of the box, for every block on this page."
                    },
                    {
                        "question": "Do these answers help my SEO?",
                        "answer": "Yes — FAQ blocks render as structured data, so search engines can read the questions too."
                    }
                ]
            }
