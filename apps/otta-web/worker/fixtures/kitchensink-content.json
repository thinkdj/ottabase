            "data": {
                "items": [
                    {
                        "title": "Install it",
                        "content": "Add @ottabase/ottaeditor to your project and install."
                    },
                    {
                        "title": "Turn on the plugins",
                        "content": "Set defaultPlugins: \"all\" to get every block on this page."
                    },
                    {
                        "title": "Drop it on a page",
                        "content": "Call useOttaEditor(), attach the ref, and start typing."
                    },
                    {
                        "title": "Take the content with you",
                        "content": "exportJSON() for storage, exportMarkdown() for everywhere else."
                    }
                ]
