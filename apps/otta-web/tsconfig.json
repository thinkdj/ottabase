{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@ottabase/cf/*": ["../../packages/cf/src/*"],
            "@ottabase/cf-realtime": ["../../packages/cf-realtime/src/index.ts"],
            "@ottabase/cf-realtime/server": ["../../packages/cf-realtime/src/server/index.ts"],
            "@ottabase/cf-realtime/client": ["../../packages/cf-realtime/src/client/index.ts"],
            "@ottabase/cf-pdf": ["../../packages/cf-pdf/src/index.ts"],
            "@ottabase/cf-pdf/client": ["../../packages/cf-pdf/src/client.ts"],
            "@ottabase/cf-pdf/metadata": ["../../packages/cf-pdf/src/metadata.ts"],
            "@ottabase/cf-pdf/router": ["../../packages/cf-pdf/src/routes.ts"],
            "@ottabase/cf-pdf/server": ["../../packages/cf-pdf/src/server.ts"],
            "@ottabase/cf-pdf/react": ["../../packages/cf-pdf/src/react/index.tsx"],
            "@ottabase/rbac/admin-guard": ["../../packages/rbac/src/admin-guard.ts"],
            "@ottabase/rbac/request-context": ["../../packages/rbac/src/request-context.ts"],
            "@ottabase/db/drizzle-d1": ["../../packages/db/src/drizzle/drizzle-d1.ts"],
            "@ottabase/db/drizzle": ["../../packages/db/src/drizzle/drizzle.ts"],
            "@ottabase/db/*": ["../../packages/db/src/*"],
            "@ottabase/ottablog": ["../../packages/ottablog/src/index.ts"],
            "@ottabase/ottaai": ["../../packages/ottaai/src/index.ts"],
            "@ottabase/ottaai/*": ["../../packages/ottaai/src/*"],
            /*
             * ottaorm subpaths MUST be mapped explicitly.
             *
             * The `@ottabase/*` catch-all below expands `@ottabase/ottaorm/models` to
             * `packages/ottaorm/models/src`, which does not exist — so TypeScript silently
             * falls back to node resolution and picks up `dist`, while a bare
             * `@ottabase/ottaorm` import resolves to `src`. That gives the program TWO
             * DISTINCT `BaseModel` classes, and every `registerModels([...])` call fails
             * with "Property 'getTable' is protected but type 'BaseModel' is not a class
             * derived from 'BaseModel'". Reproduce with a one-liner:
             *     registerModels([VerificationToken])
             */
            "@ottabase/ottaorm": ["../../packages/ottaorm/src/index.ts"],
            "@ottabase/ottaorm/models": ["../../packages/ottaorm/src/models/index.ts"],
            "@ottabase/ottaorm/base": ["../../packages/ottaorm/src/base/index.ts"],
            "@ottabase/ottaorm/client": ["../../packages/ottaorm/src/client/index.ts"],
            /*
             * Headless-decoupling subpaths. These packages moved their rendered React behind an
             * isolated subpath (or, for auth, the pure config helpers to ./config). They must be
             * mapped explicitly to source: the `@ottabase/*` catch-all below expands e.g.
             * `@ottabase/forms/react` to `packages/forms/react/src` (nonexistent), and the
             * dist-only fallback is unreliable. Mirror these in apps/otta-web/vitest.config.ts.
             */
            "@ottabase/auth/config": ["../../packages/auth/src/components/helpers.ts"],
            "@ottabase/forms/react": ["../../packages/forms/src/react.ts"],
            "@ottabase/ui-datatable/react": ["../../packages/ui-datatable/src/react.ts"],
            "@ottabase/spotlight/react": ["../../packages/spotlight/src/react.ts"],
            "@ottabase/docs/react": ["../../packages/docs/src/react.ts"],
            "@ottabase/medialibrary/react": ["../../packages/medialibrary/src/react.ts"],
            "@ottabase/ottablog/renderer": ["../../packages/ottablog/src/renderer.ts"],
            "@ottabase/ottamenu/render": ["../../packages/ottamenu/src/render/index.tsx"],
            "@ottabase/premium": ["../../packages/premium/src/index.ts"],
            "@ottabase/premium/server": ["../../packages/premium/src/server/index.ts"],
            "@ottabase/premium/react": ["../../packages/premium/src/react/index.ts"],
            "@ottabase/premium-webhooks": ["../../packages/premium-webhooks/src/index.ts"],
            "@ottabase/premium-webhooks/schema": ["../../packages/premium-webhooks/src/schema.ts"],
            "@ottabase/premium-webhooks/react": ["../../packages/premium-webhooks/src/react/index.ts"],
            "@ottabase/*": ["../../packages/*/src"]
        },
        "types": ["vite/client"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": [
        "node_modules",
        "dist",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx",
        "src/**/__tests__/**",
        "src/lib/auth-backend.ts",
        "src/ottabase/models/**"
    ]
}
