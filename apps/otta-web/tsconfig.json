{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@ottabase/cf/*": ["../../packages/cf/src/*"],
            "@ottabase/cf-realtime": ["../../packages/cf-realtime/src/index.ts"],
            "@ottabase/cf-realtime/server": ["../../packages/cf-realtime/src/server/index.ts"],
            "@ottabase/cf-realtime/client": ["../../packages/cf-realtime/src/client/index.ts"],
            "@ottabase/rbac/admin-guard": ["../../packages/rbac/src/admin-guard.ts"],
            "@ottabase/rbac/request-context": ["../../packages/rbac/src/request-context.ts"],
            "@ottabase/db/drizzle-d1": ["../../packages/db/src/drizzle/drizzle-d1.ts"],
            "@ottabase/db/drizzle": ["../../packages/db/src/drizzle/drizzle.ts"],
            "@ottabase/db/*": ["../../packages/db/src/*"],
            "@ottabase/ottablog": ["../../packages/ottablog/src/index.ts"],
            "@ottabase/ottaai": ["../../packages/ottaai/src/index.ts"],
            "@ottabase/ottaai/*": ["../../packages/ottaai/src/*"],
            /*
             * ottaorm subpaths MUST be mapped explicitly.
             *
             * The `@ottabase/*` catch-all below expands `@ottabase/ottaorm/models` to
             * `packages/ottaorm/models/src`, which does not exist — so TypeScript silently
             * falls back to node resolution and picks up `dist`, while a bare
             * `@ottabase/ottaorm` import resolves to `src`. That gives the program TWO
             * DISTINCT `BaseModel` classes, and every `registerModels([...])` call fails
             * with "Property 'getTable' is protected but type 'BaseModel' is not a class
             * derived from 'BaseModel'". Reproduce with a one-liner:
             *     registerModels([VerificationToken])
             */
            "@ottabase/ottaorm": ["../../packages/ottaorm/src/index.ts"],
            "@ottabase/ottaorm/models": ["../../packages/ottaorm/src/models/index.ts"],
            "@ottabase/ottaorm/base": ["../../packages/ottaorm/src/base/index.ts"],
            "@ottabase/ottaorm/client": ["../../packages/ottaorm/src/client/index.ts"],
            "@ottabase/*": ["../../packages/*/src"]
        },
        "types": ["@cloudflare/workers-types"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "ottabase/**/*.ts",
        "worker/**/*.ts",
        "vite.config.ts",
        "cloudflare-worker.ts",
        "cloudflare-env.d.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
