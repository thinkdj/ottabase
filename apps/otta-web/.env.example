# ============================================================
# Auth Configuration - Environment Variables
# ============================================================
#
# This file documents all the environment variables needed for
# production-ready authentication in the Vite template app.
#
# For local development:
# 1. Copy this file to .env.local
# 2. Fill in the values for the providers you want to use
# 3. The auth system will auto-configure based on what's available
#
# For production (Cloudflare):
# 1. Set these in wrangler.jsonc under "vars" or use secrets
# 2. Use: wrangler secret put AUTH_SECRET
# 3. Use: wrangler secret put GOOGLE_CLIENT_SECRET (for sensitive values)
#

# ============================================================
# Development Notes
# ============================================================
#
# 1. At minimum, you need AUTH_SECRET and OBCF_D1 for credentials login
# 2. Add any OAuth provider to enable social login
# 3. Add EMAIL_RESEND_API_KEY or EMAIL_SERVER to enable magic links
# 4. The auth system will show warnings for missing providers
# 5. All auth methods work independently - configure what you need
#
# ============================================================

# ============================================================
# Required: Auth Secret
# ============================================================
# Generate a secure random string (32+ characters)
# Command: openssl rand -base64 32
#
# REQUIRED in every non-dev environment. Auth now fails closed: if AUTH_SECRET is
# missing, sessions/CSRF/OAuth-state are NOT signed with a built-in default unless
# BOTH ENVIRONMENT is an explicit dev value (development/dev/test/local) AND
# AUTH_ALLOW_INSECURE_DEV_SECRET=true are set (see wrangler.jsonc dev vars).
AUTH_SECRET=

# ============================================================
# Required: Secrets
# ============================================================
# Generate a secure random string (32+ characters)
# Command: openssl rand -base64 32
MIGRATION_SECRET=
BOOTSTRAP_OWNER_SECRET=

# Protects POST /api/blog/publish-scheduled (meant for an external cron caller, not a browser).
# Send it as `X-Cron-Secret: <value>` or `Authorization: Bearer <value>`. Open in dev when unset.
CRON_SECRET=

# ============================================================
# OAuth Providers (Optional - configure the ones you need)
# ============================================================

# Google OAuth
# Get credentials: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# Get credentials: https://github.com/settings/developers
# 1. Create new OAuth App
# 2. Set callback URL: https://your-domain.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth
# Get credentials: https://discord.com/developers/applications
# 1. Create new application
# 2. Add redirect: https://your-domain.com/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Azure AD / Microsoft OAuth
# Get credentials: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Auth0
# Get credentials: https://manage.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER=

# ============================================================
# Email Provider (Magic Link - Optional)
# ============================================================

# Option 0: Local Dev Mail Trap (KV-backed catchall inbox)
# Captures emails in the Vite admin app instead of sending them.
# Requires OBCF_KV binding and is intended for local development only.
DEV_EMAIL_TRAP_ENABLED=true
DEV_EMAIL_TRAP_MAX_EMAILS=50

# Option 1: Resend (Recommended)
# Get API key: https://resend.com/
EMAIL_RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Option 2: Nodemailer/SMTP
# PS: This wont work in default Cloudflare Workers / Edge
# Format: smtp://username:password@smtp.example.com:587
# EMAIL_SERVER=smtp://user:pass@smtp.gmail.com:587
# EMAIL_FROM=noreply@yourdomain.com

# ============================================================
# Cloudflare Bindings (Configured in wrangler.jsonc)
# ============================================================
# These are NOT environment variables, but Worker bindings:
# - OBCF_D1: D1 Database for auth tables
# - OBCF_KV: KV namespace (required for auth session verification/revocation; also used for
#   rate limiting and the local dev mail trap)
# - OBCF_R2: R2 bucket (optional, for file uploads)
# - OBCF_QUEUE: Queue (optional, for async tasks)
# - OBCF_RATE_LIMITER: Rate limiter (optional, for API protection)
# - OBCF_REALTIME: Durable Object (optional, for websockets)
# - OBCF_ASSETS: Static assets (required, for serving frontend)
# ============================================================

# ============================================================
# Database Configuration
# ============================================================
# The D1 database must have auth tables created
# Run: pnpm db:push
# Or navigate to: /api/ottaorm/init in your browser

# ============================================================
# Platform Kill Switches
# ============================================================
# Set to true to block all POST/PUT/PATCH/DELETE (read-only mode)
KILLSWITCH_READONLY_MODE=false
# Set to true to return a static "LOCKDOWN ENFORCED" page for every route
KILLSWITCH_LOCKDOWN=false


# Feature gates / flags
# By default destructive migrations are disabled. Set to '1' or 'true' to enable.
MIGRATION_ALLOW_DESTRUCTIVE=0

# ============================================================
# Package Toggles (Worker only — overrides ottabase.config.ts)
# ============================================================
# Worker routes use getOttabaseConfig(env); client uses static config.
# Set to "true" or "false" to enable/disable at runtime per deployment.
# OTTABASE_PKG_OTTABLOG=true
# OTTABASE_PKG_SHORTLINKS=true
# OTTABASE_PKG_REFERRALS=true

# ============================================================
# Premium Packages  (@ottabase/premium)
# ============================================================
# Which Premium Packages are INSTALLED is decided in ottabase/config.premium.ts.
# These variables decide whether an installed one is LICENSED and switched on.
#
# ── Licensing a package ──────────────────────────────────────
# One variable per package, named PREMIUM_LICENSE_<KEY> (key upper-snake-cased):
# PREMIUM_LICENSE_WEBHOOKS=obp1.…
#
# Or one JSON map for several packages at once:
# PREMIUM_LICENSES={"webhooks":"obp1.…","reports":"obp1.…"}
#
# An env-supplied license OUTRANKS one pasted at Admin → Growth → Premium packages,
# deliberately: the key in your infrastructure config must be the key actually in
# force, not a value someone changed through a browser six months ago.
#
# Licenses are verified OFFLINE (ECDSA P-256, Web Crypto). No key ever leaves the
# deployment and there is no phone-home on the request path.
#
# ── Switching a package off ──────────────────────────────────
# Overrides everything, including a valid license. Use it as a kill switch.
# PREMIUM_PKG_WEBHOOKS=false
#
# ── Trying the shipped example ───────────────────────────────
# @ottabase/premium-webhooks ships a DEMO license (its keypair is published in the
# repo, so it proves nothing about payment — it exists so the activation flow can be
# tried end to end). See packages/premium-webhooks/README.md.

# ============================================================
# Referrals
# ============================================================
# Inbound referral link query-param key (e.g. ?ref=johndoe). Owner-configurable
# in ottabase.config.ts (features.referrals.referralParam); this env var overrides
# it where the worker resolves config. Letters/digits/underscore/hyphen only;
# anything else falls back to "ref". Default: ref
# REFERRAL_PARAM=ref


# ============================================================
# AI provisioning / BYOK  (@ottabase/ottaai)
# ============================================================
# Enable/disable the whole feature (also `packages.ottaai` in ottabase.config.ts).
# OTTABASE_PKG_OTTAAI=true
#
# ── The one REQUIRED secret ──────────────────────────────────
# Master secret for tenant provider keys (HKDF-SHA-256 → AES-256-GCM at rest).
# Generate with a CSPRNG, NEVER type one:   openssl rand -base64 48
# Rejected at boot below 32 bytes of decoded material — a weak secret turns one
# stolen database backup into an offline break of every tenant's key.
# The feature stays DORMANT (routes off, UI hidden) until this is set.
# AI_CREDENTIAL_SECRET=
#
# ── Rotation (use INSTEAD of AI_CREDENTIAL_SECRET) ───────────
# A keyring plus the id of the write key. Both secrets stay readable while the
# re-wrap job drains the old one; retire only when the ENVELOPE scan reports zero.
# AI_CREDENTIAL_KEYRING={"k1":"<old base64 secret>","k2":"<new base64 secret>"}
# AI_CREDENTIAL_KEY_ID=k2
#
# ── Platform floor (OPTIONAL) ────────────────────────────────
# Leave unset to ship BYOK-only: every task then upsells instead of falling back.
# The provider is DECLARED, never inferred from a key prefix (which goes stale),
# and boot fails if the default model targets a different provider.
# OTTAAI_PLATFORM_PROVIDER=openai
# OTTAAI_PLATFORM_MODEL=gpt-4o-mini
# CFAI_OPENAI_API_KEY=
# CFAI_ANTHROPIC_API_KEY=
#
# ── Cloudflare AI Gateway ────────────────────────────────────
# CLOUDFLARE_ACCOUNT_ID is already set in wrangler env vars for production.
# CFAI_GATEWAY_NAME=production
# CFAI_GATEWAY_TOKEN=            # only when the gateway is authenticated
#
# ── Azure OpenAI (OPERATOR-ONLY destination values) ──────────
# Azure's gateway path is /azure-openai/{resource}/{deployment}/chat/completions.
# ALL THREE or none: without them the transport reports Azure as unservable and
# hides it from the BYOK form — better than accepting a tenant key for calls that
# can never route. These are operator config, never tenant-writable.
# CFAI_AZURE_RESOURCE_NAME=
# CFAI_AZURE_DEPLOYMENT_NAME=
# CFAI_AZURE_API_VERSION=2024-10-21
#
# ── Inference rate limits (calls per minute) ─────────────────
# A BEST-EFFORT BURST GUARD, NOT A BILLING QUOTA — it bounds how many calls, not
# total spend, and the counters are eventually consistent (effective ceiling is
# roughly the limit plus in-flight concurrency).
# All dimensions are CHECKED before any is CHARGED, so a call rejected on one
# dimension consumes none of the others.
# These matter most once a platform provider key is set above: without a limiter,
# any authenticated user can loop /api/ai/complete on the operator's key.
# Platform-paid inference is REFUSED (fail closed) when OBCF_KV is not bound, or
# when PER_APP is not positive — that is the only aggregate ceiling.
# An invalid value (negative / non-numeric) falls back to the configured value.
# OTTAAI_RATE_LIMIT_PER_USER=20      # 0 disables
# OTTAAI_RATE_LIMIT_PER_ORG=120      # 0 disables
# OTTAAI_RATE_LIMIT_PER_APP=600      # must be > 0 wherever the operator can be billed
#
# ── Dials (non-secret; prefer ottabase.config.ts features.ottaai) ──
# FROZEN AT MAJOR and logged once at boot — changing mode or strategy silently
# re-points which key a tenant's calls use.
# OTTAAI_MODE=auto                     # platform | auto | byok
# OTTAAI_STRATEGY=user-then-org        # user | org | user-then-org | org-then-user
# OTTAAI_APP_SCOPE=strict              # strict | wildcard  (strict is the only safe FIRST setting)
# OTTAAI_BYOK_ENABLED=true             # the kill switch: false ⇒ platform-only, gates degrade to soft
# OTTAAI_ALLOW_ORG_CREDENTIALS=true
