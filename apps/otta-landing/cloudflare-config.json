{
    "$schema": "../../schemas/cloudflare-config.schema.json",
    "deployable": true,
    "previewDeployable": true,
    "appType": "nextjs",
    "buildCommand": "build",
    "workerBuildCommand": "build:worker",
    "verifyPaths": [".open-next"],
    "wranglerConfig": "wrangler.jsonc",
    "wranglerEnv": "production",
    "healthCheckPath": "/",
    "requiresSecrets": [],
    "requiresPreviewSecrets": [],
    "$comment": "The app's deploy manifest, read by otta deploy wherever it runs. build runs next build, then build:worker turns it into the Worker bundle (OpenNext)."
}
