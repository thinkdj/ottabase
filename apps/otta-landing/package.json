{
    "name": "@ottabase/otta-landing",
    "version": "1.0.0",
    "private": true,
    "ottabase": {
        "start": {
            "development": {
                "processes": [
                    {
                        "name": "web",
                        "script": "dev",
                        "url": "http://127.0.0.1:3000",
                        "portEnv": "PORT",
                        "primary": true
                    }
                ]
            },
            "worker": {
                "url": "http://127.0.0.1:8788",
                "unsupportedPlatforms": {
                    "win32": "OpenNext Worker packaging requires symlinks that are not reliable on native Windows. Run this named environment from WSL or Linux."
                }
            },
            "readyTimeoutMs": 90000
        }
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build --webpack",
        "build:worker": "node ./scripts/ensure-opennext-dirs.mjs && opennextjs-cloudflare build --skipBuild",
        "start": "next start",
        "lint": "eslint .",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "preview": "pnpm build && pnpm build:worker && wrangler dev",
        "deploy": "pnpm build && pnpm build:worker && wrangler deploy",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "wrangler": "wrangler",
        "localflare": "localflare"
    },
    "dependencies": {
        "@ottabase/config": "workspace:*",
        "@ottabase/db": "workspace:*",
        "@ottabase/ottalanding": "workspace:*",
        "@ottabase/ottaorm": "workspace:*",
        "@ottabase/utils": "workspace:*",
        "next": "^16.1.1",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:",
        "@opennextjs/cloudflare": "^1.11.0",
        "@ottabase/ui-tailwind": "workspace:*",
        "@tailwindcss/forms": "catalog:",
        "@tailwindcss/typography": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "autoprefixer": "catalog:",
        "eslint": "catalog:",
        "eslint-config-next": "^16.1.1",
        "postcss": "catalog:",
        "postcss-preset-env": "catalog:",
        "tailwindcss": "catalog:",
        "tailwindcss-animate": "catalog:",
        "typescript": "catalog:",
        "wrangler": "catalog:",
        "localflare": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "apps/otta-landing"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/apps/otta-landing#readme"
}
