{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Wrangler configuration for Next.js homepage app with brand-engine integration
    // Minimal configuration for a simple homepage with Cloudflare Workers

    "name": "otta-landing",
    "compatibility_date": "2024-12-30",
    // No Preview URLs (<version>-<name>.<subdomain>.workers.dev): left unset, Cloudflare turns them on with
    // workers.dev and every uploaded version answers publicly. Inherited by every env block; set it true in
    // one to have them there. PR previews are their own Workers and do not need them.
    "preview_urls": false,
    // Main worker configuration
    // OpenNext for Cloudflare creates .open-next/worker.js as the entry point
    "main": ".open-next/worker.js",
    // For next.js apps
    "compatibility_flags": [
        // Enable Node.js API
        "nodejs_compat",
        // Allow to fetch URLs in your app
        "global_fetch_strictly_public",
    ],

    // Keep Wrangler bundling enabled so OpenNext's relative worker modules
    // (e.g. ./cloudflare/images.js) are uploaded during deploy validation.

    // Observability - logging configuration
    "observability": {
        "enabled": true,
    },

    // The SAME D1 database as apps/otta-web: otta-web's admin writes the landing content,
    // this app reads it. Locally the D1 is keyed by `preview_database_id` ("preview"), and
    // next.config.js points the dev proxy at otta-web's .wrangler state, so both apps open
    // the same SQLite file. Keep these blocks identical to otta-web/wrangler.jsonc.
    "d1_databases": [
        {
            "binding": "OBCF_D1",
            "database_name": "ottabase-db",
            "database_id": "YOUR_D1_DATABASE_ID",
            "preview_database_id": "preview",
        },
    ],
    // The SAME public files bucket as apps/otta-web (its OBCF_R2): images picked in its admin are
    // /api/files/public/<key> URLs, which app/api/files/public serves from here too. Only the public
    // bucket is bound: otta-web's private files and backups live in buckets this app never sees.
    // Local R2 is keyed by preview_bucket_name, so keep both names identical to otta-web/wrangler.jsonc.
    "r2_buckets": [
        {
            "binding": "OBCF_R2",
            "bucket_name": "ottabase-bucket",
            "preview_bucket_name": "ottabase-bucket-preview",
        },
    ],
    // Asset bindings
    "assets": {
        "directory": ".open-next/assets",
        "binding": "OBCF_ASSETS",
    },

    // Environment variables
    "vars": {
        // Which app's landing content to show (otta-web's config.appId)
        "APP_ID": "otta-web",
        // R2_PUBLIC_URL: base URL of the public files bucket, set to the same value as otta-web's
        // (its custom domain) in any environment that has one. Unset: app/api/files/public serves them.
        "ENVIRONMENT": "development",
        "NODE_ENV": "production",
        // Cloudflare Turnstile, the bot check on the lead form: the widget's site key (public, so it
        // lives here) with TURNSTILE_SECRET_KEY set as a secret. Checks run only when both are set;
        // empty is off. Each env below has its own, so a deploy never inherits the local one.
        // Cloudflare's test keys (always pass: 1x00000000000000000000AA and secret
        // 1x0000000000000000000000000000000AA) work on localhost.
        "TURNSTILE_SITE_KEY": "",
    },

    // Local development settings
    "dev": {
        "port": 8788,
        "local_protocol": "http",
    },

    // Cloudflare Images binding (required by @opennextjs/cloudflare worker bundle)
    // No cost when images.unoptimized = true in next.config.js
    "images": {
        "binding": "IMAGES",
    },

    // Limits configuration
    "limits": {
        "cpu_ms": 50000,
    },

    // Environment-specific overrides
    "env": {
        "production": {
            // Same D1 as otta-web's production environment (same placeholder → same database)
            "d1_databases": [{ "binding": "OBCF_D1", "database_name": "ottabase-db", "database_id": "D1_DATABASE_ID" }],
            "r2_buckets": [{ "binding": "OBCF_R2", "bucket_name": "ottabase-bucket" }],
            "vars": {
                "ENVIRONMENT": "production",
                "APP_ID": "otta-web",
                "NODE_ENV": "production",
                "TURNSTILE_SITE_KEY": "", // Paste the widget's site key; TURNSTILE_SECRET_KEY is a secret
            },
            // Asset bindings for Production
            "assets": {
                "binding": "OBCF_ASSETS",
                "directory": ".open-next/assets",
            },
            "images": {
                "binding": "IMAGES",
            },
        },
        // Local staging lifecycle. Deployment remains separately CI-controlled.
        "staging": {
            // Same D1 as otta-web's staging environment (same placeholder → same database)
            "d1_databases": [
                {
                    "binding": "OBCF_D1",
                    "database_name": "ottabase-db-staging",
                    "database_id": "YOUR_STAGING_D1_DATABASE_ID",
                },
            ],
            "r2_buckets": [{ "binding": "OBCF_R2", "bucket_name": "ottabase-bucket-staging" }],
            "vars": {
                "ENVIRONMENT": "staging",
                "APP_ID": "otta-web",
                "NODE_ENV": "production",
                "TURNSTILE_SITE_KEY": "", // Paste the widget's site key; TURNSTILE_SECRET_KEY is a secret
            },
            "assets": {
                "binding": "OBCF_ASSETS",
                "directory": ".open-next/assets",
            },
            "images": {
                "binding": "IMAGES",
            },
        },
        // Preview environment for PR deployments
        // The deploy workflow reads this block to verify secrets and generate wrangler.preview.jsonc
        "preview": {
            // Same D1 as otta-web's preview environment (same placeholder → same database)
            "d1_databases": [
                {
                    "binding": "OBCF_D1",
                    "database_name": "ottabase-db-preview",
                    "database_id": "D1_PREVIEW_DATABASE_ID",
                },
            ],
            "r2_buckets": [{ "binding": "OBCF_R2", "bucket_name": "ottabase-bucket-preview" }],
            "vars": {
                "ENVIRONMENT": "preview",
                "APP_ID": "otta-web",
                "NODE_ENV": "production",
                "TURNSTILE_SITE_KEY": "", // Paste the widget's site key; TURNSTILE_SECRET_KEY is a secret
            },
            // Asset bindings for Preview
            "assets": {
                "binding": "OBCF_ASSETS",
                "directory": ".open-next/assets",
            },
            "images": {
                "binding": "IMAGES",
            },
        },
    },
}
