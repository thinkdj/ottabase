{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["@cloudflare/workers-types"],
        "allowJs": false,
        // The generated corpus is declared in worker/generated.d.ts instead of being read and inferred.
        "resolveJsonModule": false,
        "noEmit": true
    },
    "include": ["worker/**/*.ts", "scripts/**/*.ts", "__tests__/**/*.ts"]
}
