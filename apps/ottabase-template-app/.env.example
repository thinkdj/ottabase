# App Meta Configuration
NEXT_PUBLIC_APP_NAME="Ottabase Template App"
NEXT_PUBLIC_APP_TITLE="Ottabase Template - Modern Next.js Starter"
NEXT_PUBLIC_APP_DESCRIPTION="A template application built with Ottabase monorepo - CDC Starter Kit equivalent"
NEXT_PUBLIC_APP_LOGO_URL="/logo.png"
NEXT_PUBLIC_APP_AUTHOR="Ottabase Team"
NEXT_PUBLIC_APP_KEYWORDS="Ottabase, Next.js Starter Kit, Tailwind, Mantine, Shadcn, Tremor, HTML, React, Next.js, TypeScript, JavaScript, Node.js, MongoDB"
NEXT_PUBLIC_APP_ROBOTS="index, follow"
NEXT_PUBLIC_APP_COPYRIGHT_TEXT="© 2020-2024 Ottabase Team"
NEXT_PUBLIC_APP_COMPANY_NAME="Ottabase"

# UI Framework Configuration
NEXT_PUBLIC_UI_FRAMEWORK="mantine"

# UI Configuration
NEXT_PUBLIC_PREVENT_FOUC="false"
NEXT_PUBLIC_PREVENT_FOUC_INSIDE_IFRAME="false"
NEXT_PUBLIC_UI_DEBOUNCE_MS="500"
NEXT_PUBLIC_UI_LAYOUT_MIN_WIDTH="320"
NEXT_PUBLIC_UI_LAYOUT_MAX_WIDTH="1280"
NEXT_PUBLIC_ENFORCE_GOOGLE_FONTS="true"

# Theme Configuration
NEXT_PUBLIC_THEME_COLOR_DEFAULT="tremorBlue"

# Storage Configuration
NEXT_PUBLIC_STORAGE_PREFIX="ottabase"

# API Configuration
NEXT_PUBLIC_SERVER_ERROR_HTTP_CODE="500"

# Feature: Spotlight
NEXT_PUBLIC_SPOTLIGHT_ENABLED="true"

# Feature: CrudHub
NEXT_PUBLIC_CRUDHUB_API_BASE_URL="/api/crudhub"
NEXT_PUBLIC_CRUDHUB_URL_BASE="crudhub"
NEXT_PUBLIC_CRUDHUB_URL_BASE_LISTING="browse"

# Feature: Pagination
NEXT_PUBLIC_PAGE_SIZE_DEFAULT="10"
NEXT_PUBLIC_PAGE_SIZE_MAX="100"

# Model Configuration
NEXT_PUBLIC_MODEL_DEFAULT_REL_KEY="defaults"

# Development
NODE_ENV="development"

# ============================================================
# Database Configuration (Prisma + D1)
# ============================================================
# This DATABASE_URL is ONLY used for:
#   - Prisma CLI (migration generation)
#   - Local testing (not runtime in Cloudflare Workers)
#
# For D1 runtime queries, the app uses env.DB binding from wrangler.jsonc
# See: wrangler.jsonc → d1_databases[].binding = "DB"
#
# For local migration testing:
DATABASE_URL="file:./prisma/dev.db"

# ============================================================
# Authentication Configuration (Auth.js)
# ============================================================

# Auth.js Secret (REQUIRED)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here_change_this_in_production

# Next Auth URL (REQUIRED for production)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth (Optional)
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Discord OAuth (Optional)
# Get credentials from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Microsoft Azure AD (Optional)
# Get credentials from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
AZURE_AD_CLIENT_ID=your_azure_client_id
AZURE_AD_CLIENT_SECRET=your_azure_client_secret
AZURE_AD_TENANT_ID=your_azure_tenant_id

# Auth0 (Optional)
# Get credentials from: https://manage.auth0.com/
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_ISSUER=https://your-domain.auth0.com

# Email Provider (Optional)
# For magic link authentication
EMAIL_SERVER=smtp://username:password@smtp.example.com:587
EMAIL_FROM=noreply@example.com

# Credentials Provider (Optional)
# Enable username/password authentication
AUTH_LOGIN_CREDENTIALS=false

# Disable Sign-ins (Optional)
# Set to true to temporarily disable all sign-ins
AUTH_DISABLE_SIGNINS=false