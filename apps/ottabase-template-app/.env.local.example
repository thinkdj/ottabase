# =============================================================================
# CLOUDFLARE RESOURCES
# =============================================================================
# These IDs are automatically populated by running: pnpm cloudflare:setup
# The setup script will check/create resources and write the IDs here.
# 
# NEVER commit .env.local with real IDs - keep this file for reference only!
# =============================================================================

# D1 Database ID (UUID from: wrangler d1 list)
CF_D1_DATABASE_ID=

# KV Namespace ID (from: wrangler kv namespace list)
CF_KV_NAMESPACE_ID=

# KV Preview Namespace ID (optional, for preview deployments)
CF_KV_PREVIEW_ID=

# Rate Limiter Namespace ID (from Cloudflare Dashboard > Rate Limiting)
CF_RATE_LIMITER_NAMESPACE_ID=

# =============================================================================
# OTHER ENVIRONMENT VARIABLES
# =============================================================================

NEXT_TELEMETRY_DISABLED=1

# Auth.js Secret (v5)
AUTH_SECRET=your-auth-secret-here

# NextAuth Secret (legacy, v4 compatibility)
NEXTAUTH_SECRET=your-auth-secret-here

# NextAuth URL
NEXTAUTH_URL=http://localhost:3000

AUTH_LOGIN_CREDENTIALS=true
AUTH_LOGIN_GITHUB=true

# Cloudflare R2 Configuration (Server-side only - secure)
# Get these from: https://dash.cloudflare.com/ > R2 > Manage R2 API Tokens
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET_NAME=
CF_R2_PUBLIC_URL=
