{
    "name": "@ottabase/vault",
    "version": "0.1.0",
    "description": "Backups, restore and per-tenant export for Ottabase apps: D1 tables to R2 as NDJSON, restored in one transaction, with a nightly schedule and retention",
    "ottabase": {
        "key": "vault",
        "factory": "createVaultPackage",
        "adminPages": [
            {
                "path": "/admin/infrastructure/vault",
                "title": "Vault",
                "description": "Backups to R2, restore, and per-tenant export.",
                "icon": "Archive",
                "group": "infrastructure",
                "scope": "platform",
                "page": "admin/infrastructure/VaultPage",
                "export": "VaultPage"
            }
        ]
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./react": {
            "types": "./src/react/index.ts",
            "default": "./src/react/index.ts"
        }
    },
    "sideEffects": false,
    "scripts": {
        "clean": "rimraf .turbo node_modules",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@ottabase/kernel": "workspace:*",
        "@ottabase/ottaorm": "workspace:*",
        "@ottabase/ottarouter": "workspace:*",
        "@ottabase/utils": "workspace:*"
    },
    "peerDependencies": {
        "@ottabase/ui": "workspace:*",
        "@tanstack/react-query": "catalog:",
        "lucide-react": "catalog:",
        "react": "catalog:"
    },
    "peerDependenciesMeta": {
        "@ottabase/ui": {
            "optional": true
        },
        "@tanstack/react-query": {
            "optional": true
        },
        "lucide-react": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@ottabase/ui": "workspace:*",
        "@tanstack/react-query": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "lucide-react": "catalog:",
        "react": "catalog:",
        "rimraf": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/vault"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/vault#readme"
}
