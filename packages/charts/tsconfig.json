{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "outDir": "dist",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "paths": {},
        "types": ["vitest/globals", "@testing-library/jest-dom"]
    },
    "include": ["src/**/*", "__tests__/**/*"],
    "exclude": ["dist", "node_modules"]
}
