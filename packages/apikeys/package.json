{
    "name": "@ottabase/apikeys",
    "version": "0.1.0",
    "description": "API keys for the end users of an Ottabase app: hashed at rest, scoped, expiring, revocable, shown once, verified in one lookup",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./schema": {
            "types": "./src/schema.ts",
            "default": "./src/schema.ts"
        }
    },
    "sideEffects": false,
    "scripts": {
        "clean": "rimraf .turbo node_modules",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@ottabase/kernel": "workspace:*",
        "@ottabase/ottaorm": "workspace:*",
        "@ottabase/ottarouter": "workspace:*",
        "@ottabase/utils": "workspace:*"
    },
    "peerDependencies": {
        "drizzle-orm": "catalog:"
    },
    "devDependencies": {
        "drizzle-orm": "catalog:",
        "rimraf": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/apikeys"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/apikeys#readme"
}
