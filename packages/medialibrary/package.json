{
    "name": "@ottabase/medialibrary",
    "version": "0.0.1",
    "description": "Media library primitives and viewer components for Ottabase apps",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./react": {
            "types": "./src/react.ts",
            "default": "./src/react.ts"
        }
    },
    "sideEffects": false,
    "scripts": {
