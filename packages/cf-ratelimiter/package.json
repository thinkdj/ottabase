{
  "name": "@ottabase/cf-ratelimiter",
  "version": "1.0.0",
  "description": "Cloudflare Durable Objects-based rate limiter for API protection",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./durable-object": {
      "types": "./dist/durable-object.d.ts",
      "import": "./dist/durable-object.mjs",
      "require": "./dist/durable-object.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/durable-object.ts src/middleware.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/durable-object.ts src/middleware.ts --format cjs,esm --dts --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "cloudflare",
    "rate-limit",
    "durable-objects",
    "workers",
    "nextjs",
    "middleware"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "typescript": "catalog:",
    "tsup": "catalog:",
    "rimraf": "catalog:",
    "eslint": "catalog:"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
