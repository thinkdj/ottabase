{
    "name": "linen",
    "typography": {
        "heading": {
            "fontFamily": "Newsreader",
            "url": "https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&display=swap"
        },
        "body": {
            "fontFamily": "Source Serif 4",
            "url": "https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&display=swap"
        },
        "handwriting": {
            "fontFamily": "Caveat",
            "url": "https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&display=swap"
        }
    },
    "radius": "0.3rem",
    "spacing": {
        "section": "3rem",
        "card": "1.25rem",
        "element": "0.5rem"
    },
    "shadows": {
        "xs": "0 1px 1px rgb(40 24 8 / 0.04)",
        "sm": "0 1px 2px rgb(40 24 8 / 0.05)",
        "md": "0 4px 12px -4px rgb(40 24 8 / 0.08)",
        "lg": "0 12px 24px -8px rgb(40 24 8 / 0.1)",
        "xl": "0 20px 32px -12px rgb(40 24 8 / 0.12)"
    },
    "motion": {
        "durationFast": "120ms",
        "durationNormal": "220ms",
        "durationSlow": "480ms",
        "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
        "easingEnter": "cubic-bezier(0.16, 1, 0.3, 1)",
        "easingExit": "cubic-bezier(0.4, 0, 1, 1)"
    },
