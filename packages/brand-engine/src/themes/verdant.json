            "md": "0 4px 12px rgb(18 26 21 / 0.08), 0 16px 32px -12px rgb(18 26 21 / 0.16)",
            "lg": "0 24px 56px -12px rgb(18 26 21 / 0.28)",
            "xl": "0 24px 56px -12px rgb(18 26 21 / 0.28)"
