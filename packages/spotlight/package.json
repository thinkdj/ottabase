{
    "name": "@ottabase/spotlight",
    "version": "1.0.0",
    "description": "Lightweight spotlight/command palette component with dark mode support",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "import": "./dist/react.mjs",
            "require": "./dist/react.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "clean": "rimraf dist",
        "lint": "eslint src --ext .ts,.tsx",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "keywords": [
        "react",
        "spotlight",
        "command-palette",
        "search",
        "keyboard-shortcuts"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@ottabase/config": "workspace:*"
    },
    "peerDependencies": {
        "@ottabase/ui-shadcn": "workspace:*",
        "@radix-ui/react-dialog": "^1.1.4",
        "@tabler/icons-react": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "peerDependenciesMeta": {
        "@ottabase/ui-shadcn": {
            "optional": true
        },
        "@radix-ui/react-dialog": {
            "optional": true
        },
        "@tabler/icons-react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@testing-library/react": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "eslint": "catalog:",
        "jsdom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "rimraf": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/spotlight"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/spotlight#readme"
}
