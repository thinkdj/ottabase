{
    "name": "@ottabase/comments",
    "version": "0.0.1",
    "description": "Threaded comment system for Ottabase apps: polymorphic, nestable, with reactions and moderation",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./schema": {
            "types": "./src/schema.ts",
            "default": "./src/schema.ts"
        },
        "./react": {
            "types": "./src/react/index.ts",
            "default": "./src/react/index.ts"
        }
    },
    "scripts": {
        "clean": "rm -rf .turbo node_modules",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "@ottabase/ui-shadcn": "workspace:*",
        "drizzle-orm": "catalog:",
        "lucide-react": "catalog:",
        "react": "catalog:"
    },
    "dependencies": {
        "@ottabase/ottaorm": "workspace:*"
    },
    "devDependencies": {
        "@ottabase/ui-shadcn": "workspace:*",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "drizzle-orm": "catalog:",
        "jsdom": "catalog:",
        "lucide-react": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/comments"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/comments#readme",
    "peerDependenciesMeta": {
        "@ottabase/ui-shadcn": {
            "optional": true
        },
        "lucide-react": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    }
}
