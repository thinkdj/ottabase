{
    "name": "@ottabase/ottablog",
    "version": "0.0.1",
    "description": "Blog and content management system for Ottabase apps - supports blog posts, changelogs, and documentation",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./renderer": {
            "types": "./src/components/BlogRenderer.tsx",
            "default": "./src/components/BlogRenderer.tsx"
        }
    },
    "scripts": {
        "clean": "pnpm exec rm -rf .turbo node_modules",
        "test": "pnpm exec vitest",
        "test:coverage": "pnpm exec vitest --coverage"
    },
    "peerDependencies": {
        "drizzle-orm": "catalog:",
        "react": "^18 || ^19",
        "@ottabase/ottaorm": "workspace:*",
        "@ottabase/ottarenderer": "workspace:*"
    },
    "dependencies": {
        "@ottabase/ottaorm": "workspace:*",
        "@ottabase/ottarenderer": "workspace:*"
    },
    "devDependencies": {
        "@types/react": "catalog:",
        "drizzle-orm": "catalog:",
        "react": "catalog:",
        "typescript": "catalog:"
    },
    "keywords": [
        "blog",
        "cms",
        "content",
        "changelog",
        "documentation",
        "ottabase",
        "cloudflare",
        "d1"
    ]
}
