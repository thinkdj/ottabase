{
    "name": "@ottabase/premium",
    "version": "0.0.1",
    "description": "Paid-package framework for Ottabase apps — manifests, offline license verification, entitlements, lifecycle hooks, gated routes and drop-in admin UI",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "import": "./dist/server/index.js",
            "require": "./dist/server/index.cjs"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js",
            "require": "./dist/react/index.cjs"
        },
        "./license-tools": {
            "types": "./dist/license-tools.d.ts",
            "import": "./dist/license-tools.js",
            "require": "./dist/license-tools.cjs"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/server/index.ts src/react/index.ts src/license-tools.ts --format cjs,esm --dts --clean",
        "clean": "rimraf dist",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@ottabase/ottarouter": "workspace:*",
        "@ottabase/utils": "workspace:*"
    },
    "peerDependencies": {
        "@ottabase/ui-shadcn": "workspace:*",
        "@tanstack/react-query": "catalog:",
        "lucide-react": "catalog:",
        "react": "catalog:"
    },
    "peerDependenciesMeta": {
        "@ottabase/ui-shadcn": {
            "optional": true
        },
        "@tanstack/react-query": {
            "optional": true
        },
        "lucide-react": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@ottabase/config": "workspace:*",
        "@ottabase/ui-shadcn": "workspace:*",
        "@tanstack/react-query": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/react": "catalog:",
        "eslint": "catalog:",
        "jsdom": "catalog:",
        "lucide-react": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "rimraf": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "keywords": [
        "ottabase",
        "premium",
        "paid-packages",
        "licensing",
        "entitlements",
        "saas",
        "cloudflare"
    ],
    "author": "thinkdj",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/premium"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/premium#readme"
}
