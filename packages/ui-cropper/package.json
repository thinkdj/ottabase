{
    "name": "@ottabase/ui-cropper",
    "version": "1.0.0",
    "description": "Vanilla image cropper, fixed-viewfinder model: pan, pinch, zoom, rotate, straighten and flip the photo under a frame that fills the stage. Rect or circle, any aspect. Zero React.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "cropper",
        "image",
        "crop",
        "flip",
        "rotate",
        "zoom",
        "vanilla",
        "image-cropper",
        "photo-editor",
        "canvas",
        "resize",
        "drag",
        "transitions",
        "animations"
    ],
    "license": "MIT",
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean && node scripts/copy-css.js",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "clean": "rimraf dist",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint src"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "rimraf": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/ui-cropper"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/ui-cropper#readme"
}
