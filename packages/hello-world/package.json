{
    "name": "@ottabase/hello-world",
    "version": "1.0.1",
    "description": "A simple hello world React component package",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "pnpm exec tsup src/index.ts --format cjs,esm --dts --clean",
        "dev": "pnpm exec tsup src/index.ts --format cjs,esm --dts --watch",
        "clean": "pnpm exec rimraf dist",
        "lint": "pnpm exec eslint src --ext .ts,.tsx",
        "type-check": "pnpm exec tsc --noEmit",
        "test": "pnpm exec vitest",
        "test:coverage": "pnpm exec vitest --coverage"
    },
    "keywords": [
        "react",
        "component",
        "hello-world",
        "tsx"
    ],
    "author": "",
    "license": "MIT",
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "typescript": "catalog:",
        "tsup": "catalog:",
        "rimraf": "catalog:",
        "eslint": "catalog:"
    }
}
