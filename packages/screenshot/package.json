{
    "name": "@ottabase/screenshot",
    "version": "0.1.0",
    "description": "Automated screenshots over the Chrome DevTools Protocol: png, jpeg or webp with quality, an optimization pass, a Node runner for scripts and a Browser Rendering route for Workers",
    "ottabase": {
        "key": "screenshot",
        "factory": "createScreenshotPackage"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./node": {
            "types": "./src/node.ts",
            "default": "./src/node.ts"
        }
    },
    "sideEffects": false,
    "scripts": {
        "clean": "rimraf .turbo node_modules",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@ottabase/kernel": "workspace:*",
        "@ottabase/ottarouter": "workspace:*",
        "@ottabase/utils": "workspace:*"
    },
    "peerDependencies": {
        "sharp": ">=0.33.0"
    },
    "peerDependenciesMeta": {
        "sharp": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "rimraf": "catalog:",
        "sharp": "^0.34.5",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/screenshot"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/screenshot#readme"
}
