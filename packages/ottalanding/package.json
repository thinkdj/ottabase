{
    "name": "@ottabase/ottalanding",
    "version": "0.0.1",
    "description": "Database-backed landing sites for Ottabase apps: typed page sections, site settings, and swappable themes",
    "ottabase": {
        "key": "ottalanding",
        "factory": "createOttalandingPackage"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./schema": {
            "types": "./src/schema.ts",
            "default": "./src/schema.ts"
        },
        "./react": {
            "types": "./src/react/index.tsx",
            "default": "./src/react/index.tsx"
        }
    },
    "scripts": {
        "clean": "rm -rf .turbo node_modules",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "drizzle-orm": "catalog:",
        "react": "catalog:"
    },
    "dependencies": {
        "@ottabase/kernel": "workspace:*",
        "@ottabase/api": "workspace:*",
        "@ottabase/brand-engine": "workspace:*",
        "@ottabase/ottaorm": "workspace:*",
        "@ottabase/utils": "workspace:*",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@ottabase/db": "workspace:*",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "drizzle-orm": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/ottalanding"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/ottalanding#readme"
}
