{
  "name": "@ottabase/ottaorm",
  "version": "1.0.0",
  "description": "Drizzle-based ORM for Ottabase applications with D1 support - class-based models with relationships, validations, and metadata",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./models": {
      "types": "./src/models/index.ts",
      "import": "./src/models/index.ts",
      "require": "./src/models/index.ts"
    },
    "./base": {
      "types": "./src/base/index.ts",
      "import": "./src/base/index.ts",
      "require": "./src/base/index.ts"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/models/index.ts src/base/index.ts src/client/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/models/index.ts src/base/index.ts src/client/index.ts --format cjs,esm --dts --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "drizzle",
    "orm",
    "database",
    "d1",
    "cloudflare",
    "models",
    "relationships",
    "tanstack-query",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ottabase/db": "workspace:*"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "drizzle-orm": ">=0.30.0",
    "mongodb": ">=6.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "mongodb": "catalog:",
    "react": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}