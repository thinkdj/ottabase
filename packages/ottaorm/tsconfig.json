{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        // Shared workspace utilities resolve to source through the root path aliases.
        // A package-local rootDir would reject those imports during DTS generation.
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "lib": ["ES2020", "DOM"],
        "types": ["@cloudflare/workers-types"]
    },
    "include": ["src/**/*"],
    // auto-generator.ts is Node-only CLI tooling (fs/child_process/process), not part of the
    // edge-bundled library and not imported by it. It's excluded from the edge type-check, which
    // deliberately ships only @cloudflare/workers-types.
    "exclude": ["dist", "node_modules", "**/*.test.*", "**/*.spec.*", "src/migrations/auto-generator.ts"]
}
