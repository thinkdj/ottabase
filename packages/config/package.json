{
    "name": "@ottabase/config",
    "version": "1.0.0",
    "description": "Shared configuration utilities for Ottabase applications",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "pnpm exec tsup src/index.ts --format cjs,esm --dts --clean",
        "dev": "pnpm exec tsup src/index.ts --format cjs,esm --dts --watch",
        "clean": "pnpm exec rimraf dist",
        "lint": "pnpm exec eslint src --ext .ts,.tsx",
        "type-check": "pnpm exec tsc --noEmit",
        "test": "pnpm exec vitest",
        "test:coverage": "pnpm exec vitest --coverage"
    },
    "keywords": [
        "config",
        "environment",
        "configuration",
        "monorepo"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "tsup": "catalog:",
        "rimraf": "catalog:",
        "eslint": "catalog:"
    }
}
