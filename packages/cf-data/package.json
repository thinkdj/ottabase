{
  "name": "@ottabase/cf-data",
  "version": "1.0.0",
  "description": "Production-ready Cloudflare KV and D1 data layer with caching support",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./kv": {
      "types": "./dist/kv/index.d.ts",
      "import": "./dist/kv/index.mjs",
      "require": "./dist/kv/index.js"
    },
    "./d1": {
      "types": "./dist/d1/index.d.ts",
      "import": "./dist/d1/index.mjs",
      "require": "./dist/d1/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.mjs",
      "require": "./dist/cache/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/kv/index.ts src/d1/index.ts src/cache/index.ts src/types/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/kv/index.ts src/d1/index.ts src/cache/index.ts src/types/index.ts --format cjs,esm --dts --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "cloudflare",
    "kv",
    "d1",
    "cache",
    "data-layer",
    "workers",
    "edge",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4.0.0",
    "@prisma/client": ">=5.22.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@prisma/client": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
