{
    "name": "@ottabase/webhooks",
    "version": "1.0.0",
    "description": "Outbound webhooks for Ottabase apps: HMAC-signed deliveries, endpoint health, and a delivery log",
    "ottabase": {
        "key": "webhooks",
        "factory": "createWebhooksPackage",
        "export": "webhooksPackage",
        "tables": {
            "import": "@ottabase/webhooks/schema",
            "names": [
                "webhookDeliveriesTable",
                "webhookEndpointsTable"
            ]
        },
        "adminPages": [
            {
                "path": "/admin/growth/webhooks",
                "title": "Webhooks",
                "description": "Outbound event delivery with signed payloads, endpoint health, and a delivery log.",
                "icon": "Webhook",
                "group": "growth",
                "scope": "org",
                "page": "admin/growth/WebhooksPage",
                "export": "WebhooksPage"
            }
        ]
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/schema.js",
            "require": "./dist/schema.cjs"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js",
            "require": "./dist/react/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/schema.ts src/react/index.ts --format cjs,esm --dts --clean",
        "clean": "rimraf dist",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@ottabase/kernel": "workspace:*",
        "@ottabase/ottaorm": "workspace:*",
        "@ottabase/ottarouter": "workspace:*",
        "@ottabase/utils": "workspace:*"
    },
    "peerDependencies": {
        "@ottabase/ui": "workspace:*",
        "@tanstack/react-query": "catalog:",
        "drizzle-orm": "catalog:",
        "lucide-react": "catalog:",
        "react": "catalog:"
    },
    "peerDependenciesMeta": {
        "@ottabase/ui": {
            "optional": true
        },
        "@tanstack/react-query": {
            "optional": true
        },
        "lucide-react": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@ottabase/config": "workspace:*",
        "@ottabase/ui": "workspace:*",
        "@tanstack/react-query": "catalog:",
        "@types/react": "catalog:",
        "drizzle-orm": "catalog:",
        "eslint": "catalog:",
        "lucide-react": "catalog:",
        "react": "catalog:",
        "rimraf": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "keywords": [
        "ottabase",
        "webhooks",
        "hmac",
        "cloudflare"
    ],
    "author": "thinkdj",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/webhooks"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/webhooks#readme"
}
