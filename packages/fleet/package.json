{
    "name": "@ottabase/fleet",
    "version": "0.1.0",
    "description": "The beacon that makes an Ottabase app watchable: GET /api/fleet/report behind FLEET_TOKEN returns its packages and versions, license states, health, scheduled tasks and newest backup; POST /api/fleet/init relays the host init",
    "ottabase": {
        "key": "fleet",
        "factory": "createFleetPackage"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "sideEffects": false,
    "scripts": {
        "clean": "rimraf .turbo node_modules",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@ottabase/kernel": "workspace:*",
        "@ottabase/ottaorm": "workspace:*",
        "@ottabase/ottarouter": "workspace:*",
        "@ottabase/utils": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "rimraf": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/fleet"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/fleet#readme"
}
