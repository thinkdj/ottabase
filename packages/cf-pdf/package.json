{
    "name": "@ottabase/cf-pdf",
    "version": "1.0.0",
    "description": "PDF generation toolkit for Cloudflare Workers — Puppeteer rendering, DOM capture, binary metadata injection, and download helpers.",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./metadata": {
            "types": "./dist/metadata.d.ts",
            "import": "./dist/metadata.js",
            "require": "./dist/metadata.cjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js",
            "require": "./dist/server.cjs"
        },
        "./router": {
            "types": "./dist/routes.d.ts",
            "import": "./dist/routes.js",
            "require": "./dist/routes.cjs"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "require": "./dist/client.cjs"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js",
            "require": "./dist/react/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@ottabase/ottarouter": "workspace:*",
        "@ottabase/utils": "workspace:*"
    },
    "peerDependencies": {
        "@cloudflare/puppeteer": "catalog:",
        "react": "catalog:"
    },
    "peerDependenciesMeta": {
        "@cloudflare/puppeteer": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@cloudflare/puppeteer": "catalog:",
        "@cloudflare/workers-types": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "eslint": "catalog:",
        "react": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "keywords": [
        "pdf",
        "cloudflare",
        "puppeteer",
        "workers",
        "dom-capture",
        "metadata",
        "ottabase"
    ],
    "author": "thinkdj",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/cf-pdf"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/cf-pdf#readme"
}
