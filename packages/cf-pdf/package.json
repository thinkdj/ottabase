{
    "name": "@ottabase/cf-pdf",
    "version": "1.0.0",
    "description": "Zero-dependency PDF generation toolkit for Cloudflare Workers — Puppeteer rendering, DOM capture, binary metadata injection, and download helpers.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./metadata": {
            "types": "./dist/metadata.d.ts",
            "import": "./dist/metadata.mjs",
            "require": "./dist/metadata.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs",
            "require": "./dist/server.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.mjs",
            "require": "./dist/client.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "keywords": [
        "pdf",
        "cloudflare",
        "puppeteer",
        "workers",
        "dom-capture",
        "metadata",
        "ottabase"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:",
        "@types/node": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:"
    }
}
