{
    "name": "@ottabase/scripts",
    "version": "1.0.0",
    "description": "Utility scripts for Ottabase monorepo - Cloudflare resource setup and cache management CLIs",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "bin": {
        "otta-help": "bin/help.cjs",
        "env-secrets": "bin/env-secrets.cjs",
        "cloudflare-login": "bin/cloudflare-login.cjs",
        "cloudflare-setup": "bin/cloudflare-setup.cjs",
        "cloudflare-validate": "bin/cloudflare-validate.cjs",
        "clean-cache": "bin/clean-cache.cjs",
        "clean-d1": "bin/clean-d1.mjs",
        "clean-kv": "bin/clean-kv.mjs",
        "clean-state": "bin/clean-state.mjs",
        "clean-all": "bin/clean-all.mjs",
        "kill-ports": "bin/kill-ports.cjs"
    },
    "files": [
        "dist",
        "bin",
        "README.md"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/cli/cloudflare-setup.ts src/cli/cloudflare-validate.ts src/cli/cloudflare-login.ts src/cli/clean-cache.ts src/cli/kill-ports.ts src/cli/env-secrets.ts src/cli/help.ts --format cjs,esm --dts --clean",
        "dev": "tsup src/index.ts src/cli/cloudflare-setup.ts src/cli/cloudflare-validate.ts src/cli/cloudflare-login.ts src/cli/clean-cache.ts src/cli/kill-ports.ts src/cli/env-secrets.ts src/cli/help.ts --format cjs,esm --dts --watch",
        "clean": "rimraf dist",
        "clean-cache": "node bin/clean-cache.cjs",
        "otta-help": "node bin/help.cjs",
        "env-secrets": "node bin/env-secrets.cjs",
        "clean-d1": "node bin/clean-d1.mjs",
        "clean-kv": "node bin/clean-kv.mjs",
        "clean-state": "node bin/clean-state.mjs",
        "clean-all": "node bin/clean-all.mjs",
        "kill-ports": "node bin/kill-ports.cjs",
        "cloudflare-login": "node bin/cloudflare-login.cjs",
        "cloudflare-setup": "node bin/cloudflare-setup.cjs",
        "cloudflare-validate": "node bin/cloudflare-validate.cjs",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "keywords": [
        "scripts",
        "cloudflare-d1",
        "monorepo"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@inquirer/checkbox": "^5.0.7"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "rimraf": "catalog:",
        "ts-node": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinkdj/ottabase.git",
        "directory": "packages/scripts"
    },
    "bugs": {
        "url": "https://github.com/thinkdj/ottabase/issues"
    },
    "homepage": "https://github.com/thinkdj/ottabase/tree/main/packages/scripts#readme"
}
