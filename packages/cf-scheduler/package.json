{
  "name": "@ottabase/cf-scheduler",
  "version": "0.1.0",
  "description": "Database-driven task scheduler with cron support for Cloudflare Workers and D1",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server/index.ts src/client/index.ts src/types/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/server/index.ts src/client/index.ts src/types/index.ts --format cjs,esm --dts --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "cloudflare",
    "scheduler",
    "cron",
    "d1",
    "workers",
    "task-scheduler",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ottabase/cf": "workspace:*",
    "@ottabase/config": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250127.0",
    "typescript": "catalog:",
    "tsup": "catalog:",
    "rimraf": "catalog:",
    "eslint": "catalog:"
  }
}
