{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["dom", "dom.iterable", "ES6"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "baseUrl": ".",
        "paths": {
            /* Pattern-based path mapping for all packages */
            "@ottabase/*": ["./packages/*/src"],
            /* Individual package mappings for direct imports */
            "@ottabase/config": ["./packages/config/src"],
            "@ottabase/state": ["./packages/state/src"],
            "@ottabase/scripts": ["./packages/scripts/src"],
            "@ottabase/db": ["./packages/db/src"],
            "@ottabase/ui-code-highlight": ["./packages/ui-code-highlight/src"],
            "@ottabase/ui-tailwind": ["./packages/ui-tailwind/src"],
            /* @ottabase/ui subpaths that live outside its src/ (the pattern above would miss them) */
            "@ottabase/ui/json-editor": ["./packages/ui/components/ui/json-editor.tsx"],
            "@ottabase/ui/lib/utils": ["./packages/ui/src/lib/utils.ts"],
            "@ottabase/ui/brand-components": ["./packages/ui/providers/brand-components.tsx"],
            "@ottabase/utils": ["./packages/utils/src"],
            "@ottabase/utils/*": ["./packages/utils/src/*"],
            "@ottabase/cron": ["./packages/cron/src"]
        }
    },
    "include": ["./packages/**/src/**/*.ts", "./packages/**/src/**/*.tsx"],
    "exclude": ["node_modules"],
    "references": [
        {
            "path": "./packages/config"
        },
        {
            "path": "./packages/state"
        },
        {
            "path": "./packages/db"
        },
        {
            "path": "./packages/ottaorm"
        },
        {
            "path": "./packages/scripts"
        },
        {
            "path": "./packages/ui-code-highlight"
        },
        {
            "path": "./packages/ui-tailwind"
        },
        {
            "path": "./packages/utils"
        },
        {
            "path": "./packages/ui"
        },
        {
            "path": "./packages/cron"
        }
    ]
}
